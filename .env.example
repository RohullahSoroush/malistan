# Optional. Production builds on Vercel always use https://malistan.org.
# Set this only to override the address for previews or other hosts.
NEXT_PUBLIC_SITE_URL=

# Contact form (server only, never prefixed with NEXT_PUBLIC_). Messages are sent with Resend.
# RESEND_API_KEY is required. Without it the form opens the visitor's email app instead.
RESEND_API_KEY=
# Optional. The sender must be on a domain verified in Resend.
CONTACT_FROM="Malistan Archive <website@malistan.org>"
# Optional. Where messages are delivered.
CONTACT_TO=hello@malistan.org

# The archive database (the same Supabase project as admin.malistan.org). SERVER ONLY — never NEXT_PUBLIC_.
# SUPABASE_ANON_KEY is the project's *publishable* key: it can read published content and file contact messages, nothing
# else. Without it the site shows its built-in content and messages are only emailed.
SUPABASE_ANON_KEY=
# Optional: defaults to the archive's project.
SUPABASE_URL=
