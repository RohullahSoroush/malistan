# Optional. Production builds on Vercel always use https://malistan.org.
# Set this only to override the address for previews or other hosts.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (https://web3forms.com). Create a free access key for hello@malistan.org
# and add it in Vercel as NEXT_PUBLIC_WEB3FORMS_KEY. Without it, the form opens the visitor's email app.
NEXT_PUBLIC_WEB3FORMS_KEY=
